{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PromptJob",
  "description": "Shared event shape for raw-prompts and finished-prompts topics",
  "type": "object",
  "required": ["job_id", "prompt"],
  "properties": {
    "job_id": {
      "type": "string",
      "description": "UUID assigned at submit time; Kafka message key"
    },
    "correlation_id": {
      "type": "string",
      "description": "Optional client-supplied trace id"
    },
    "prompt": {
      "type": "string"
    },
    "result": {
      "type": "string",
      "description": "Present on finished-prompts only"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "completed", "failed"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
